# DIMZSTORE CI4 - Apache Routing
Options -Indexes
Options +FollowSymlinks

# Force HTTPS (aktifkan di production)
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jika file/folder beneran ada, serve langsung (CSS, JS, gambar)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Selain itu, lempar ke index.php
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Blokir akses ke file environment & VCS
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Security headers (CI4 Filter juga set ini, ini fallback level Apache)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Disable PHP error display in production via php_flag if available
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

# Cache static aset
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
