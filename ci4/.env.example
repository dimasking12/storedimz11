#--------------------------------------------------------------------
# ENVIRONMENT (development | production | testing)
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Sesuaikan dengan domain & path tempat folder /ci4/public di-host.
# Contoh: app.baseURL = 'https://vip1120.site/botdimas/ci4/public/'
app.baseURL = 'https://vip1120.site/botdimas/ci4/public/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# Session Cookie - WAJIB sama dgn legacy PHP supaya sesi user nyambung
# (legacy pakai default PHPSESSID jadi biarkan default).
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'PHPSESSID'
app.sessionExpiration = 0
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

#--------------------------------------------------------------------
# DATABASE - MySQL (sama dengan config.php legacy)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = vipc7892_Dimz_db
database.default.username = vipc7892_Dimas1120
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# PAYMENT GATEWAY (Arie / DIMZ merchant)
#--------------------------------------------------------------------
payment.apiKey =
payment.merchantCode = DIMZ1945

#--------------------------------------------------------------------
# TELEGRAM BOT (utk notifikasi order & rental)
#--------------------------------------------------------------------
telegram.botToken =
telegram.adminChatId =

#--------------------------------------------------------------------
# SECURITY (CSRF & Cookie)
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_test_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
